---
import { Icon } from 'astro-icon/components';

const { platform, href } = Astro.props;

const iconNames = {
  github: "simple-icons:github",
  bluesky: "simple-icons:bluesky"
};
---

<a href={href} class="navbar-item social-link" target="_blank" rel="noopener noreferrer">
  <span class="icon">
    <Icon name={iconNames[platform]} />
  </span>
</a>

<style>
  .icon {
    width: 1.5rem;
    height: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  [data-icon] {
    width: 100%;
    height: 100%;
  }

  .social-link:hover {
    color: var(--hover-color, #0085ff);
  }
</style>