---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;
---
<BaseLayout pageTitle={frontmatter.title}>
  <section class="container content section">
      <h1 class="title is-3">
      <a href="/projects/">
        <svg class="back-button" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M6 0H5L0 5L5 10H6V6H12V15H14V4H6V0Z" fill="#ffffff"></path> </g></svg></svg>
      </a>
        {frontmatter.title} ({frontmatter.year})
      </h1>
      <h2 class="subtitle is-4">
        {frontmatter.role ? frontmatter.role : ""} {frontmatter.company ? `• ${frontmatter.company}` : ""}
      </h2>
      {frontmatter && frontmatter.mediaType === "video" ? (
        <video autoplay muted loop playsinline class="project-thumb-video">
          <source src={frontmatter.mediaSrc} type="video/mp4" />
        </video>
        ) : (
        <img src={frontmatter && frontmatter.mediaSrc} class="project-thumb-image" />
        )}
        <h1>Overview</h1>
        <p>
          {frontmatter.features && (
              <ul>
                  {frontmatter.features?.map((feature) => <li set:html={feature}></li>)}
              </ul>
          )}
        </p>
        <slot />
  </section>
</BaseLayout>

<style>
  body {
    /* background-color: rgb(229, 186, 235); */
  }

  img {
    border-radius: 1rem 1rem 1rem 1rem;
    height: 50%  }

  video {
    border-radius: 1rem 1rem 1rem 1rem;
    max-height: 30rem;
  }

  .back-button {
    width: 0.8em;
    color: white;
  }
</style>