---
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = "Parwesh"
---
<BaseLayout pageTitle={pageTitle}>
	<div class="hero">
		<h1>Parwesh Rallapalli</h1>
		<h2>Game Designer</h2>
		<subtitle>Currently working on <b>Call of Duty&#174;: Black Ops 7</b> and an <b>indie stealth-action games</b>.</subtitle>
	</div>
	<video autoplay muted loop id="reel">
		<source type="video/mp4" src="/src/content/reel2_small.mp4" />
	</video>
</BaseLayout>
</html>

<style>
	body {
		color: white;
		text-align: left;
	}

	#reel {
		overflow: hidden;
	  	-webkit-background-size: cover;
  		-moz-background-size: cover;
 		-o-background-size: cover;
  		background-size: cover;
		position: fixed;
		top: 0%;
		bottom: -5%;
		left: 0%;
		min-width: 100%;
		min-height: 100%;
		z-index: -1;
	}
</style>
