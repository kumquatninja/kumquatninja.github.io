<style>
	.background-video {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: -1;
	}

	img {
		-webkit-filter: drop-shadow(5px 5px 8px #22222271);
		filter: drop-shadow(5px 5px 8px #22222271); 
	}

	.hero {
		display: flex;
		align-items: flex-start;
		padding-top: 5rem;
	}

	.hero::before {
		content: "";
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.4); /* Overlay for readability */
		z-index: 1;
    }

    .hero-body {
		position: relative;
		z-index: 2;
		max-width: 600px;
    }

	.hero .title,
	.hero .subtitle,
	.hero p
	{
		color: white;
		text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
	}
</style>
