---
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = "Parwesh"
---
<BaseLayout pageTitle={pageTitle}>
	<section class="hero is-fullheight-with-navbar level">
		<video autoplay muted loop playsinline class="background-video" id="reel">
			<source type="video/mp4" src="/src/content/reel2_small.mp4" />
		</video>

		<div class="hero-body level-left">
			<div class="level-item">
				<img src="/src/content/kn-logo.png" alt="Kumquat Ninja logo" width=200rem />
			</div>
			<div class="level-item">
				<div>
					<p class="title">Parwesh Rallapalli</p>
					<p class="subtitle">
						Game Designer <strong><a href="https://treyarch.com" target="_blank">@Treyarch</a></strong>
					</p>
					<p>Currently working on <a href="https://www.callofduty.com/blackops7" target="_blank">
						<em><nobr>Call of Duty&#174;: Black Ops 7</nobr></em></a> and an <em>indie stealth-action game</em>.
					</p>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
</html>

<style>
	.background-video {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: -1;
	}

	img {
		-webkit-filter: drop-shadow(5px 5px 8px #22222271);
		filter: drop-shadow(5px 5px 8px #22222271); 
	}

	.hero .title,
	.hero .subtitle,
	.hero p
	{
		color: white;
		text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
	}
</style>
