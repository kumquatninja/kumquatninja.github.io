---
import StandardPageLayout from "../layouts/StandardPageLayout.astro";
const pageTitle = "Dev";
---
<StandardPageLayout pageTitle={pageTitle}>
    <div class ="portfolio-container">
        <div class="box project">
            <div class="columns is-vcentered">
                <div class="column is-on-third">
                    <figure class="image is-3by2">
                        <img src="/src/content/heart-heist-thumb.jpg" alt="Heart Heist screenshot" />
                    </figure>
                </div>
            </div>

            <div class="column">
            <h2 class="title is-4">Call of Duty: Black Ops 7 (2025)</h2>
            <p class="subtitle is-6">AAA Multiplayer First-Person Shooter • Game Designer</p>
            <p>
                A fast-paced stealth game inspired by <em>Metal Gear Solid</em>, featuring custom AI systems, 
                reactive guard behaviors, and a focus on expressive player movement.
            </p>
            <ul>
                <li>Designed stealth and AI systems using modular Unity architecture.</li>
                <li>Built custom FMOD audio integration and visual feedback systems.</li>
            </ul>
            <a href="/heart-heist" class="button is-primary mt-3">Read More</a>
            </div>
        </div>

